rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function cls(c) { return get(/databases/$(database)/documents/classes/$(c)).data; }
    function signedIn() { return request.auth != null; }

    match /classes/{code} {
      // Students' Android app (anonymous sign-in) can read one class by its code, but cannot list classes.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if signedIn() && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid;

      match /requests/{r} {
        allow read: if signedIn() && (cls(code).teacherUid == request.auth.uid || cls(code).presidentUid == request.auth.uid);
        allow create: if signedIn() && cls(code).presidentUid == request.auth.uid
                      && request.resource.data.by == request.auth.uid && request.resource.data.status == "pending";
        allow update: if signedIn() && cls(code).teacherUid == request.auth.uid;
      }
      match /log/{l} {
        allow read, create: if signedIn() && cls(code).teacherUid == request.auth.uid;
      }
    }
  }
}
